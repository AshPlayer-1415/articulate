{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "types": []
  },
  "include": [
    "packages/core/src/**/*.ts"
  ]
}
