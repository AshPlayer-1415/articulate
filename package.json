{
  "name": "@articulate/source",
  "version": "2.3.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.2 || ^26.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/cli",
    "apps/mcp"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build-local.mjs",
    "mcp:start": "node --experimental-strip-types apps/mcp/src/server.mjs",
    "test:boundary": "node --test test/release-boundary.test.mjs",
    "test:distribution": "node --experimental-strip-types scripts/test-distribution.mjs",
    "prepare": "node scripts/build-local.mjs",
    "release:manifest": "node scripts/refresh-release-policy.mjs",
    "test:resilience": "node --experimental-strip-types scripts/test-resilience.mjs",
    "test:cursor-transport": "node scripts/test-cursor-transport.mjs",
    "test:canonical": "node --test test/canonical-package.test.mjs",
    "package:canonical": "node scripts/canonical-package.mjs seal",
    "package:install-canonical": "node scripts/canonical-package.mjs install",
    "test:work-modes": "node --experimental-strip-types scripts/test-work-modes-distribution.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "fflate": "^0.8.2",
    "typescript": "^5.8.3"
  },
  "bin": {
    "articulate": "bin/articulate.mjs"
  },
  "files": [
    "bin/articulate.mjs",
    "dist/local",
    "LICENSE",
    "NOTICE",
    "README.md"
  ]
}
